{
  "version": "0.1.0",
  "configurations": [
    {
      "type": "node",
      "name": "GameServer Run",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"],
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceRoot}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "name": "WebServer Run",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:web"],
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceRoot}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "-----------------------------------------"
    }
  ],
  "compounds": [
    {
      "name": "Run Web & Game Servers",
      "configurations": ["GameServer Run", "WebServer Run"],
      "stopAll": true
    }
  ]
}
